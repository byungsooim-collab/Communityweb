{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "trailingSlash": true,
    "headers": [
      { "source": "**/*.@(css|svg|webp|png|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
